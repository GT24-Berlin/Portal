// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum PartnerType {
  GUTACHTER
  ANWALT
}

enum CaseLane {
  GUTACHTER
  ANWALT
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT
  IN_PROGRESS
  CLOSED
}

enum GutachterCaseStatus {
  EINGEGANGEN
  DATEN_UNVOLLSTAENDIG
  GUTACHTER_KONTAKTIERT
  TERMIN_GEPLANT
  GUTACHTEN_IN_BEARBEITUNG
  GUTACHTEN_ERSTELLT
  ABGESCHLOSSEN
}

enum AnwaltCaseStatus {
  FALL_EINGEGANGEN
  FALL_IN_PRUEFUNG
  RUECKFRAGEN_IN_KLAERUNG
  FALL_BERICHT_ERSTELLT
  FALL_ABGESCHLOSSEN
}

enum AssignmentRole {
  GUTACHTER
  ANWALT
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  RELEASED
  EXPIRED
}

enum CaseAppointmentRole {
  GUTACHTER
  ANWALT
}

enum CaseAppointmentType {
  PHONE
  IN_PERSON
}

enum CaseAppointmentDuration {
  MINUTES_15
  MINUTES_30
}

enum CaseAppointmentRequestStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  ALTERNATIVE_PROPOSED
  EXPIRED
  CANCELLED
}

enum ClaimRoute {
  OPPONENT_LIABILITY
  OWN_CASCO
  UNKNOWN
}

enum CaseFileUploaderType {
  CUSTOMER
  PARTNER
  ADMIN
}

enum CaseFileVisibility {
  CUSTOMER // nur Kunde sieht
  PARTNERS // nur Partner (Gutachter/Anwalt/Admin) sehen
  CUSTOMER_AND_PARTNERS
}

enum CaseFileCategory {
  CUSTOMER_PHOTOS
  REGISTRATION_DOCS
  INSURANCE_DOCS
  GUTACHTEN
  LAW_DOCS
  OTHER
}

enum CaseFileDocumentType {
  GUTACHTEN_MAIN
  GUTACHTEN_ANLAGE_FOTOS
  GUTACHTEN_MINDERWERTREPORT
  GUTACHTEN_AUFTRAG
  RECHNUNG
  ACHSVERMESSUNG
  VERSICHERUNGSDOKUMENT
  FAHRZEUGDOKUMENT
  SONSTIGES
}

enum CaseFileClassificationStatus {
  PENDING
  CLASSIFIED
  FAILED
  MANUAL_OVERRIDE
}

enum CaseFileClassificationConfidence {
  HIGH
  MEDIUM
  LOW
}

model CaseAssignment {
  id                  String         @id @default(cuid())
  caseId              String
  role                AssignmentRole
  assigneeClerkUserId String

  status AssignmentStatus @default(PENDING)
  active Boolean          @default(true)

  activeKey String? @db.Text

  assignedAt DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  releasedAt DateTime?

  assignedByClerkUserId String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, role, activeKey]) // active=true darf es pro Case+Role nur einmal geben
  @@index([assigneeClerkUserId, role, active])
  @@index([status, active, expiresAt])
}

enum NotificationType {
  ASSIGNMENT_CREATED
  ASSIGNMENT_ACCEPTED
  ASSIGNMENT_RELEASED
  ASSIGNMENT_EXPIRED
  APPOINTMENT_REQUEST_CREATED
  APPOINTMENT_REQUEST_CONFIRMED
  APPOINTMENT_REQUEST_DECLINED
  APPOINTMENT_REQUEST_ALTERNATIVE_PROPOSED
}

model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  readAt    DateTime?

  // Empfänger (Clerk User)
  userId String

  // Kontext
  caseId String?
  role   CaseLane?

  type  NotificationType
  title String
  body  String?

  // Optional: Deep Link ins Dashboard
  href String?

  // Relations
  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([caseId])
}
model OperationalEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  caseId String?
  case   Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  domain String
  action String
  result String

  actorType String?
  actorId   String?

  message  String?
  metadata Json?

  @@index([caseId, createdAt])
  @@index([domain, action, createdAt])
  @@index([result, createdAt])
}

model CaseFile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  uploaderType CaseFileUploaderType
  uploaderId   String? // Clerk userId bei Partner/Admin oder NULL beim Customer-Token Upload

  // Wer es hochgeladen hat (Lane/Role)
  role CaseLane? // GUTACHTER | ANWALT (oder null bei Customer)

  visibility CaseFileVisibility @default(CUSTOMER_AND_PARTNERS)
  category   CaseFileCategory   @default(OTHER)

  title    String? // optional UI Label (z.B. "Gutachten PDF")
  filename String
  mimeType String?
  size     Int?

  // Verweis in Storage (Supabase Storage / S3 / lokal)
  storageKey String @db.Text

  parsedText String? @db.Text

  // Optional: original URL cache (nicht zwingend)
  // url String? @db.Text

  documentType CaseFileDocumentType?
  classificationStatus CaseFileClassificationStatus @default(PENDING)
  classificationConfidence CaseFileClassificationConfidence?
  classificationSource String?
  classificationSignals Json?
  classifiedAt DateTime?


  gutachtenInsights CaseGutachtenInsight[]

  @@index([caseId, createdAt])
  @@index([uploaderType, createdAt])
  @@index([visibility, category])
}

model CaseGutachtenInsight {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sourceCaseFileId String?
  sourceCaseFile   CaseFile? @relation(fields: [sourceCaseFileId], references: [id], onDelete: SetNull)

  status String @default("NOT_AVAILABLE")

  summaryShort String?

  schadenshoeheNetto Decimal? @db.Decimal(12, 2)
  schadenshoeheBrutto Decimal? @db.Decimal(12, 2)
  geschaetzterAnspruch Decimal? @db.Decimal(12, 2)

  reparaturkostenNetto Decimal? @db.Decimal(12, 2)
  reparaturkostenBrutto Decimal? @db.Decimal(12, 2)
  wiederbeschaffungswert Decimal? @db.Decimal(12, 2)
  restwert Decimal? @db.Decimal(12, 2)
  wertminderung Decimal? @db.Decimal(12, 2)

  nutzungsausfallProTag Decimal? @db.Decimal(12, 2)
  reparaturdauerArbeitstage Int?

  abrechnungsart String?
  mietwagenklasse String?
  reparaturwuerdig Boolean?

  notes String?
  rawExtractionJson Json?

  extractedAt DateTime?
}

model Partner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profiles PartnerProfile[]

  type   PartnerType
  name   String
  region String?
  email  String?

  leads Lead[]
  cases Case[] @relation("CasePartner")
  availabilitySlots PartnerAvailabilitySlot[]
  appointmentRequests CaseAppointmentRequest[]
}

model PartnerProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clerkUserId String @unique

  role PartnerType

  companyName   String?
  legalForm     String?
  contactPerson String?
  email         String?
  phone         String?
  website       String?
  logoUrl       String? @db.Text

  street      String?
  houseNumber String?
  zipCode     String?
  city        String?
  country     String?
  region      String?

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([partnerId])
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalId String?    @unique // z.B. "LD-1001" (optional)
  name       String
  firstName  String?
  lastName   String?
  email      String?
  phone      String?
  street     String?
  houseNumber String?
  zipCode    String?
  city       String?
  region     String?
  source     String?
  status     LeadStatus @default(NEW)

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  // Optional: Lead kann zu einem Case werden
  case Case?
}

model Case {
  id            String           @id @default(cuid())
  assignments   CaseAssignment[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  notifications Notification[]
  caseNumber    String?          @unique // z.B. "CS-2002" (optional)
  customer      CaseCustomer?
  intake        CaseIntake?
  files         CaseFile[]
  gutachtenInsights CaseGutachtenInsight[]

  // Case Token ohne Login (Link wie /case/<token>)
  token String @unique

  // Partner-Zuordnung (B2B)
  partnerId String?
  partner   Partner? @relation("CasePartner", fields: [partnerId], references: [id])

  // Lead Beziehung (optional, 1:1)
  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id])

  // Track Status (aktuell)
  gutachterStatus GutachterCaseStatus @default(EINGEGANGEN)
  anwaltStatus    AnwaltCaseStatus    @default(FALL_EINGEGANGEN)

  // Artefakte/Downloads (später)
  gutachtenPdfUrl String?

  // Timeline-Events (historisch)
  events           CaseEvent[]
  operationalEvents OperationalEvent[]
  caseCustomerOtps CaseCustomerOtp[]
  appointmentRequests CaseAppointmentRequest[]
}

model CaseNumberSequence {
  id           String @id
  currentValue Int    @default(0)
}

model CaseCustomer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String

  // Optional später:
  // verifiedAt DateTime?
  // lastSeenAt DateTime?

  otpCodeHash   String?
  otpExpiresAt  DateTime?
  otpVerifiedAt DateTime?
  otpLastSentAt DateTime?
  otpAttempts   Int       @default(0)

  @@index([email])
}

model CaseCustomerOtp {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime

  // Fall / Token Kontext
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Wir senden OTP an diese Email (normalisiert in Code)
  email String

  // OTP Handling (wir speichern NICHT den Klartext-Code, sondern einen Hash)
  codeHash String

  // Rate limit / Sicherheit
  attempts Int @default(0)
  lastSentAt DateTime?

  // falls erfolgreich verifiziert
  verifiedAt DateTime?

  // pro Case+Email soll nur ein "aktuelles" OTP existieren (wir upserten später)
  @@unique([caseId, email])
  @@index([caseId])
  @@index([email])
  @@index([expiresAt])
}

model CaseIntake {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // --- Steuerung: Wer reguliert? ---
  claimRoute ClaimRoute @default(UNKNOWN)

  // --- Unfall (Kern) ---
  accidentDescription String?
  accidentDate        DateTime?
  accidentLocation    String? // Freitext oder später: Straße/PLZ/Ort getrennt

  // --- Fahrer ---
  driverIsHolder Boolean? // true/false/null
  driverName     String?
  driverPhone    String?

  // --- Eigenes Fahrzeug ---
  ownPlateNumber String?
  ownCarMake     String?
  ownCarModel    String?
  ownCarYear     Int?
  ownerName      String? // Halter (Name)

  // --- Gegnerfahrzeug ---
  opponentPlateNumber String?
  opponentCarMake     String?
  opponentCarModel    String?

  // --- Polizei / Zeugen ---
  policeInvolved     Boolean?
  policeReportNumber String?
  witnessesPresent   Boolean?
  witnessContact     String? // Freitext (Name+Telefon)

  // --- LEGACY (nicht mehr nutzen; nur damit Prisma nichts droppen will) ---
  insuranceName   String?
  insuranceNumber String?
  insuranceEmail  String?

  carMake     String?
  carModel    String?
  carYear     Int?
  plateNumber String?
  holderName  String?

  // Relations: Versicherungen (klar getrennt)
  ownInsurance      CaseInsurance? @relation("OwnInsurance")
  opponentInsurance CaseInsurance? @relation("OpponentInsurance")

  @@index([claimRoute])
  @@index([accidentDate])
}

enum InsuranceParty {
  OWN
  OPPONENT
}

model CaseInsurance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party InsuranceParty

  // Versicherung
  name  String?
  email String?
  phone String?

  // Vertrags-/Schadendaten
  policyNumber String?
  claimNumber  String?

  // Optionaler Ansprechpartner
  contactPerson String?

  // Relations (2 mögliche 1:1 Links, je Intake maximal 1 je Partei)
  ownIntakeId      String? @unique
  opponentIntakeId String? @unique

  intakeAsOwn      CaseIntake? @relation("OwnInsurance", fields: [ownIntakeId], references: [id], onDelete: Cascade)
  intakeAsOpponent CaseIntake? @relation("OpponentInsurance", fields: [opponentIntakeId], references: [id], onDelete: Cascade)

  @@index([party])
}

model CaseEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Prozess-Lane (nicht an Partner gebunden)
  lane CaseLane

  // Status als String, damit wir flexibel bleiben (Validierung im Code)
  status String

  note       String?
  occurredAt DateTime @default(now())

  @@index([caseId, lane, occurredAt])
}

model PartnerAvailabilitySlot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  role           CaseAppointmentRole
  appointmentType CaseAppointmentType
  duration       CaseAppointmentDuration
  weekday        Int
  startTime      String
  endTime        String
  bufferMinutes  Int       @default(15)
  isActive       Boolean   @default(true)
  specificDate   DateTime? // null = recurring weekly, set = one-time for this exact date

  @@index([partnerId])
  @@index([partnerId, role, isActive])
}

model CaseAppointmentRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId String
  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  role            CaseAppointmentRole
  appointmentType CaseAppointmentType
  duration        CaseAppointmentDuration
  status          CaseAppointmentRequestStatus @default(REQUESTED)
  requestedStartAt DateTime
  requestedEndAt   DateTime
  expiresAt        DateTime
  customerNote     String?
  partnerResponseNote String?
  confirmedAt      DateTime?
  declinedAt       DateTime?
  cancelledAt      DateTime?

  proposals CaseAppointmentProposal[]

  @@index([caseId])
  @@index([partnerId])
  @@index([status])
  @@index([requestedStartAt])
}

model CaseAppointmentProposal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointmentRequestId String
  appointmentRequest   CaseAppointmentRequest @relation(fields: [appointmentRequestId], references: [id], onDelete: Cascade)

  proposedStartAt DateTime
  proposedEndAt   DateTime
  note            String?
  acceptedAt      DateTime?
  declinedAt      DateTime?

  @@index([appointmentRequestId])
  @@index([proposedStartAt])
}
